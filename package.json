{
  "name": "s3rver",
  "version": "5.0.0",
  "description": "Fake S3 server for node",
  "keywords": [
    "fake",
    "s3",
    "server",
    "mock",
    "false",
    "aws",
    "amazon"
  ],
  "author": {
    "name": "Nobuyuki Takeuchi"
  },
  "license": "MIT",
  "homepage": "https://github.com/jamhall/s3rver",
  "scripts": {
    "coverage": "nyc npm test",
    "test": "mocha",
    "fmt": "eslint . --fix && prettier . --write",
    "prepare": "husky install"
  },
  "main": "lib/s3rver.js",
  "files": [
    "lib/",
    "example/*.xml"
  ],
  "bin": {
    "s3rver": "bin/s3rver.js"
  },
  "directories": {
    "lib": "./lib",
    "example": "./example",
    "test": "./test"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "busboy": "^1.6.0",
    "commander": "^14.0.0",
    "fast-xml-parser2": "npm:fast-xml-parser@^5.2.3",
    "he": "^1.2.0",
    "koa": "^3.0.0",
    "koa-logger": "^3.2.1",
    "lodash": "^4.17.21",
    "statuses": "^2.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "aws-sdk": "2.999.0",
    "chai": "4.3.4",
    "chai-as-promised": "7.1.1",
    "eslint": "^9.27.0",
    "eslint-plugin-mocha": "^11.0.0",
    "eslint-plugin-prettier": "^5.4.0",
    "express": "4.17.1",
    "fast-xml-parser": "^3.19.0",
    "form-data": "4.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "mocha": "9.1.2",
    "moment": "2.29.1",
    "nyc": "15.1.0",
    "p-map": "4.0.0",
    "prettier": "^3.5.3",
    "request": "2.88.2",
    "request-promise-native": "1.0.9"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
